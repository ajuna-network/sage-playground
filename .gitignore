# This .gitignore file should be placed at the root of your Unity project directory
# Based on: https://github.com/github/gitignore/blob/main/Unity.gitignore

# === Unity Generated Directories ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.utmp/

# === Unity Cache & Logs ===
*.log
*.stacktrace
sysinfo.txt

# === Unity Crash Reports ===
*.crash

# === Memory Captures (large & sensitive) ===
[Mm]emoryCaptures/

# === Recorder Outputs ===
[Rr]ecordings/

# === Unity3D Generated Meta Files ===
*.pidb.meta
*.pdb.meta
*.mdb.meta

# === Build Artifacts ===
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# === Visual Studio / Rider IDE Files ===
.vs/
.gradle/
.idea/
*.iml
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.consulo/

# === Blender Cache ===
*.blend1
*.blend1.meta

# === JetBrains Rider Plugin (Unity Autogenerated) ===
/Assets/Plugins/Editor/JetBrains*

# === Asset Store Tools (optional) ===
# /Assets/AssetStoreTools*

# === Packed Addressables ===
/Assets/AddressableAssetsData/*/*.bin*

# === Temporary Android Assets ===
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# === Visual Scripting Generated Files ===
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# === Plastic SCM (if used) ===
.PlasticSCM/
plasticSCM/

# === Merge Conflict Artifacts ===
*.merged
*.orig

# === OS-specific Files ===
.DS_Store
Thumbs.db
desktop.ini

# === VSCode Settings (optional) ===
.vscode/

# === Unity Shader Cache (optional) ===
/Assets/ShaderCache/

# === Environment Files (optional, if using .env) ===
*.env
.env.*